<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="{{ root }}site.css">
  <link rel="icon" href="{{ root }}favicon.svg" type="image/svg+xml">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site_title }}">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="{{ root }}index.html">▣ {{ site_title }}</a>
    <input id="ow-search" type="search" placeholder="Search entities…" autocomplete="off"
           aria-label="Search entities">
  </header>
  <div class="layout">
    <nav class="sidebar" aria-label="Class tree">
      <details open>
        <summary>Classes</summary>
        <ul class="tree">
          {% macro node(n) %}
          <li>
            <details {% if not n.children %}class="leaf"{% endif %}>
              <summary><a href="{{ root }}{{ n.file }}">{{ n.curie }}</a></summary>
              {% if n.children %}
              <ul>
                {% for c in n.children %}{{ node(c) }}{% endfor %}
              </ul>
              {% endif %}
            </details>
          </li>
          {% endmacro %}
          {% for n in tree %}{{ node(n) }}{% endfor %}
        </ul>
      </details>
      {% if props %}
      <details>
        <summary>Properties</summary>
        <ul class="tree">
          {% for p in props %}
          <li><details class="leaf">
            <summary><a href="{{ root }}{{ p.file }}">{{ p.curie }}</a> <span class="muted ptype">{{ p.ptype }}</span></summary>
          </details></li>
          {% endfor %}
        </ul>
      </details>
      {% endif %}
    </nav>
    <main class="content">
      {% block content %}{% endblock %}
    </main>
  </div>
  <footer class="site-footer">
    <span>Exported {{ exported_at }}{% if ontology_iri %} · from <code>{{ ontology_iri }}</code>{% endif %}</span>
  </footer>
  <div id="ow-search-results" class="search-results" hidden></div>
  <script>window.OW_ROOT = {{ root | tojson }};</script>
  <script src="{{ root }}data/search-index.js"></script>
  <script src="{{ root }}site.js"></script>
</body>
</html>
