{% extends "base.html.j2" %}
{# Domain/range cell: link only declared entities; foreign vocabulary (xsd:*)
   has no detail page, so it renders as plain code. -#}
{% macro dref(r) -%}
{%- if r.eid in known_eids %}<a href="{{ file_of(r.eid) }}"><code>{{ r.curie }}</code></a>
{%- else %}<code>{{ r.curie }}</code>{%- endif -%}
{%- endmacro %}
{% block content %}
{% set main_label = e.label.values() | list | first %}
{% set type_slug = e.type | lower %}
<article>
  {% if crumbs %}
  <nav class="crumbs" aria-label="Ancestors">
    {% for c in crumbs %}<a href="{{ c.file }}"><code>{{ c.curie }}</code></a> ▸{% endfor %}
  </nav>
  {% endif %}
  <h1>{{ main_label if main_label else e.curie }} <span class="tag tag--{{ type_slug }}">{{ e.type }}</span></h1>
  <p class="curie-line"><code>{{ e.curie }}</code></p>
  {% for lang, text in e.label.items() %}<span class="tag tag--label">{{ text }} ({{ lang }})</span>{% endfor %}
  {% if e.deprecated %}<span class="tag tag--deprecated">deprecated</span>{% endif %}
  {% if e.comment %}<p class="comment">{{ e.comment }}</p>{% endif %}

  <section class="card">
    <h2>Parents</h2>
    <ul>
      {% for p in e.parents %}<li><a href="{{ file_of(p.eid) }}"><code>{{ p.curie }}</code></a></li>
      {% else %}<li class="muted">—</li>{% endfor %}
    </ul>
  </section>

  <section class="card">
    <h2>Children ({{ e.stats.direct_children }} direct · {{ e.stats.total_descendants }} total)</h2>
    <ul>
      {% for c in e.children %}<li><a href="{{ file_of(c.eid) }}"><code>{{ c.curie }}</code></a></li>
      {% else %}<li class="muted">—</li>{% endfor %}
    </ul>
  </section>

  {% if instances %}
  <section class="card">
    <h2>Instances ({{ instances | length }})</h2>
    <ul>
      {% for i in instances %}<li><code>{{ i.curie }}</code></li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if e.properties %}
  <section class="card">
    <h2>Properties</h2>
    <table class="kv">
      <tr><th>curie</th><th>type</th><th>domain</th><th>range</th><th>label</th></tr>
      {% for p in e.properties %}
      <tr><td><a href="{{ file_of(p.eid) }}"><code>{{ p.curie }}</code></a></td>
          <td>{{ p.ptype }}</td>
          <td>{% for d in p.domain %}{{ dref(d) }}{% if not loop.last %}, {% endif %}{% else %}<span class="muted">—</span>{% endfor %}</td>
          <td>{% for r in p.range %}{{ dref(r) }}{% if not loop.last %}, {% endif %}{% else %}<span class="muted">—</span>{% endfor %}</td>
          <td class="muted">{{ p.label.values() | list | join(', ') }}</td></tr>
      {% endfor %}
    </table>
  </section>
  {% endif %}

  {% if e.referenced_by %}
  <section class="card">
    <h2>Referenced by</h2>
    <ul>
      {% for r in e.referenced_by %}
      <li><a href="{{ file_of(r.eid) }}"><code>{{ r.curie }}</code></a>
          {% if r.relation %}<span class="muted">via {{ r.relation }}</span>{% endif %}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <section class="card">
    <h2>Axioms (Turtle)</h2>
    {% for a in e.axioms %}<pre class="code">{{ a.turtle }}</pre>{% endfor %}
  </section>
</article>
{% endblock %}
