{% extends "base.html.j2" %}
{% block content %}
<h1>{{ title }}</h1>
<p class="stats muted">
  {{ counts.class_count }} classes · {{ counts.property_count }} properties ·
  {{ counts.axiom_count }} axioms{% if counts.individual_count %} ·
  {{ counts.individual_count }} individuals{% endif %}
</p>
<section class="card">
  <h2>Top-level classes</h2>
  <ul>
    {% for n in top_classes %}
    <li><a href="{{ root }}{{ n.file }}"><code>{{ n.curie }}</code></a>
      {% if n.children %}<span class="muted">({{ n.children | length }} direct subclasses)</span>{% endif %}
    </li>
    {% else %}
    <li class="muted">No OWL classes found.</li>
    {% endfor %}
  </ul>
</section>
{% if prefixes %}
<section class="card">
  <h2>Prefixes</h2>
  <table class="kv">
    {% for p, iri in prefixes.items() %}
    <tr><td><code>{{ p }}</code></td><td class="muted">{{ iri }}</td></tr>
    {% endfor %}
  </table>
</section>
{% endif %}
{% endblock %}
